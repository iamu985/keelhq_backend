digraph ERD {
    rankdir=LR;
    node [shape=none, margin=0, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10, arrowhead=none];

    // Identity domain
    LocalUser [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E1F5FE">
            <tr><td bgcolor="#B3E5FC" colspan="2"><b>local_users</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>email</td><td>TEXT UNIQUE INDEX</td></tr>
            <tr><td>username</td><td>TEXT UNIQUE INDEX</td></tr>
            <tr><td>password_hash</td><td>TEXT NOT NULL</td></tr>
            <tr><td>first_name</td><td>TEXT NOT NULL</td></tr>
            <tr><td>middle_name</td><td>TEXT</td></tr>
            <tr><td>last_name</td><td>TEXT</td></tr>
            <tr><td>is_active</td><td>BOOLEAN DEFAULT TRUE</td></tr>
            <tr><td>is_superuser</td><td>BOOLEAN DEFAULT FALSE</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    // Site Management domain
    Site [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFF3E0">
            <tr><td bgcolor="#FFE0B2" colspan="2"><b>sites</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>owner_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>name</td><td>TEXT NOT NULL</td></tr>
            <tr><td>slug</td><td>TEXT UNIQUE NOT NULL</td></tr>
            <tr><td>description</td><td>TEXT(250)</td></tr>
            <tr><td>logo_url</td><td>TEXT</td></tr>
            <tr><td>status</td><td>TEXT NOT NULL</td></tr>
            <tr><td>visibility</td><td>TEXT NOT NULL</td></tr>
            <tr><td>extension_id</td><td>UUID</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    Solution [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFF3E0">
            <tr><td bgcolor="#FFE0B2" colspan="2"><b>solutions</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>name</td><td>TEXT INDEX NOT NULL</td></tr>
            <tr><td>slug</td><td>TEXT UNIQUE NOT NULL</td></tr>
            <tr><td>display_name</td><td>TEXT NOT NULL</td></tr>
            <tr><td>description</td><td>TEXT</td></tr>
            <tr><td>icon</td><td>TEXT</td></tr>
            <tr><td>version</td><td>TEXT DEFAULT '0.1.0' NOT NULL</td></tr>
            <tr><td>is_builtin</td><td>BOOLEAN DEFAULT TRUE</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    // Content Engine domain
    EditableComponentDefinition [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F5E9">
            <tr><td bgcolor="#A5D6A7" colspan="2"><b>editable_component_definitions</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>site_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>solution_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>key</td><td>TEXT INDEX NOT NULL</td></tr>
            <tr><td>display_name</td><td>TEXT NOT NULL</td></tr>
            <tr><td>editor_schema</td><td>JSONB DEFAULT '[]' NOT NULL</td></tr>
            <tr><td>kind</td><td>ENUM NOT NULL</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    ContentEntry [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F5E9">
            <tr><td bgcolor="#A5D6A7" colspan="2"><b>content_entries</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>site_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>definition_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>content</td><td>JSONB DEFAULT '{}' NOT NULL</td></tr>
            <tr><td>status</td><td>ENUM NOT NULL</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    // Media domain
    MediaAsset [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#F3E5F5">
            <tr><td bgcolor="#CE93D8" colspan="2"><b>media_assets</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>site_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>filename</td><td>TEXT NOT NULL</td></tr>
            <tr><td>storage_key</td><td>TEXT UNIQUE INDEX NOT NULL</td></tr>
            <tr><td>mime_type</td><td>TEXT</td></tr>
            <tr><td>extension</td><td>TEXT</td></tr>
            <tr><td>size</td><td>INTEGER NOT NULL</td></tr>
            <tr><td>width</td><td>INTEGER</td></tr>
            <tr><td>height</td><td>INTEGER</td></tr>
            <tr><td>alt_text</td><td>TEXT</td></tr>
            <tr><td>metadata</td><td>JSONB DEFAULT '{}' NOT NULL</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    // Forms domain
    Form [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFEBEE">
            <tr><td bgcolor="#EF9A9A" colspan="2"><b>forms</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>site_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>name</td><td>TEXT NOT NULL</td></tr>
            <tr><td>slug</td><td>TEXT INDEX NOT NULL</td></tr>
            <tr><td>description</td><td>TEXT</td></tr>
            <tr><td>schema</td><td>JSONB DEFAULT '[]' NOT NULL</td></tr>
            <tr><td>settings</td><td>JSONB DEFAULT '{}' NOT NULL</td></tr>
            <tr><td>is_active</td><td>BOOLEAN DEFAULT TRUE NOT NULL</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    FormSubmission [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFEBEE">
            <tr><td bgcolor="#EF9A9A" colspan="2"><b>form_submissions</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>form_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>payload</td><td>JSONB DEFAULT '{}' NOT NULL</td></tr>
            <tr><td>status</td><td>ENUM INDEX DEFAULT 'pending'</td></tr>
            <tr><td>submitted_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>ip_address</td><td>TEXT</td></tr>
            <tr><td>user_agent</td><td>TEXT</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    // Integration domain
    AccessToken [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E0F2F1">
            <tr><td bgcolor="#80CBC4" colspan="2"><b>access_tokens</b></td></tr>
            <tr><td>id</td><td>UUID PK</td></tr>
            <tr><td>site_id</td><td>UUID FK INDEX</td></tr>
            <tr><td>name</td><td>TEXT NOT NULL</td></tr>
            <tr><td>description</td><td>TEXT</td></tr>
            <tr><td>token_hash</td><td>TEXT UNIQUE INDEX NOT NULL</td></tr>
            <tr><td>last_used_at</td><td>TIMESTAMP</td></tr>
            <tr><td>expires_at</td><td>TIMESTAMP</td></tr>
            <tr><td>is_active</td><td>BOOLEAN DEFAULT TRUE NOT NULL</td></tr>
            <tr><td>created_at</td><td>TIMESTAMP NOT NULL</td></tr>
            <tr><td>updated_at</td><td>TIMESTAMP</td></tr>
        </table>
    >];

    // Foreign key relationships
    LocalUser -> Site [label="owner_id", arrowhead=crow, arrowtail=tee];
    Site -> EditableComponentDefinition [label="site_id", arrowhead=crow, arrowtail=tee];
    Site -> ContentEntry [label="site_id", arrowhead=crow, arrowtail=tee];
    Site -> MediaAsset [label="site_id", arrowhead=crow, arrowtail=tee];
    Site -> Form [label="site_id", arrowhead=crow, arrowtail=tee];
    Site -> AccessToken [label="site_id", arrowhead=crow, arrowtail=tee];
    Solution -> EditableComponentDefinition [label="solution_id", arrowhead=crow, arrowtail=tee];
    EditableComponentDefinition -> ContentEntry [label="definition_id", arrowhead=crow, arrowtail=tee];
    Form -> FormSubmission [label="form_id", arrowhead=crow, arrowtail=tee];
}
